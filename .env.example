# MySQL database created from BDERP.sql
BDERP_DB_HOST=localhost
BDERP_DB_USER=BDERP
BDERP_DB_PASSWORD=
BDERP_DB_NAME=BDERP

# Twitter (X) API v1.1 credentials for the "Bolsa de Valores" window
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN_KEY=
TWITTER_ACCESS_TOKEN_SECRET=

# The "Bolsa de Valores" window is off unless this is 1 (needs `uv sync --extra twitter`)
BDERP_TWITTER_ENABLED=0
